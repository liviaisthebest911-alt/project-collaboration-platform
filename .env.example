# Copy this file to ".env" and replace every placeholder.
#   cp .env.example .env
# The real ".env" is ignored by Git. NEVER commit it.

# ---------- PostgreSQL (used by docker-compose.yml) ----------
POSTGRES_DB=project_collab
POSTGRES_USER=project_collab_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------- Backend (read by Spring Boot through application-dev.yml) ----------
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/project_collab
DB_USERNAME=project_collab_user
DB_PASSWORD=change_me

# JWT: use a long random string (at least 32 characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION_MS=86400000

# CORS origin of the frontend dev server
CORS_ALLOWED_ORIGIN=http://localhost:5173
